# Copy to .env or .env.local and fill in values.
# Vite loads .env / .env.local from project root (next to package.json).
# All frontend vars must start with VITE_.

# --- API (local dev) ---
# Base URL for API calls when not using Vite proxy (e.g. direct to server-local).
# Must include /api (e.g. http://localhost:5001/api).
# If unset, frontend uses relative /api (proxied to server-local per vite.config).
VITE_API_URL=http://localhost:5001/api

# --- Supabase (frontend: PersonReport, etc.) ---
# Required to fix "VITE_SUPABASE_URL not set". Create .env from this file and set both.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend / server-local (scripts/server-local.js) ---
GROQ_API_KEY=

# --- TTS (озвучка) ---
# Azure Speech (приоритет): Светлана, 500k символов/мес бесплатно F0. Без карты — только регистрация.
# Portal → Speech resource → Keys and Endpoint. Регион: westeurope, eastus и т.п.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Yandex SpeechKit: Алена, 1 млн символов/мес бесплатно. Yandex Cloud → SpeechKit → API key + folder ID.
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=

# Google Cloud TTS (fallback): 4 млн символов/мес (WaveNet). APIs → Text-to-Speech API → Credentials.
GOOGLE_TTS_API_KEY=

# Optional: Yandex Metrica
# VITE_YM_COUNTER_ID=106259525

# Optional: Supabase (server-side; server-local also accepts VITE_*)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
