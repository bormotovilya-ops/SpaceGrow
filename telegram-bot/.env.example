# Токен Telegram-бота (получите у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# URL вашего сайта (MiniApp)
MINIAPP_URL=https://spacegrow.vercel.app/

# Supabase (для user_segments и маркетинговых дожимов)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Яндекс.Метрика — отправка запуска бота с start-параметром (Measurement Protocol)
# Включите «Протокол измерений» в настройках счётчика и создайте токен
YANDEX_METRIKA_COUNTER_ID=12345678
YANDEX_METRIKA_MP_TOKEN=your_measurement_protocol_token
